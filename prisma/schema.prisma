// Frye Case Management — database schema
//
// This is the schema behind the Matters vertical slice and the Monday-demo
// visual-polish pass on top of it. It intentionally omits entities not
// needed yet (generic Communication) — see
// docs/DATA_MODEL.md for the full target model and docs/ROADMAP.md for
// when those land.
//
// DiscoveryProduction/DiscoveryFile/DiscoveryComparison/DiscoveryFileMatch
// were seeded by hand ahead of their originally-planned phase to back a
// visual mockup for a demo; the fifth session (see docs/ROADMAP.md) made
// the Bates numbering, hashing, and comparison engine real — see
// lib/discovery/. Older seeded productions/comparisons remain in the
// database as illustrative historical data; anything created through the
// UI now goes through the real engine.
//
// All schema changes must go through `prisma migrate dev` — never hand-edit
// the database or the generated client (see CLAUDE.md, section 4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---------------------------------------------------------------

enum UserRole {
  ADMIN
  ATTORNEY
  PARALEGAL
  STAFF
}

/// Account lifecycle state — replaces the old `active` boolean so
/// "awaiting admin approval" (self-registered via the public Sign Up page,
/// see lib/auth/signup.ts) is a distinct, explicit state from "an admin
/// deactivated this account," instead of both collapsing onto the same
/// `false`. PENDING and INACTIVE are both denied login by the exact same
/// check in lib/auth/credentials.ts#verifyPassword — the login path never
/// needs to know *why* an account isn't ACTIVE, only that it isn't.
enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum MatterStatus {
  OPEN
  PENDING
  CLOSED
}

enum AssignmentRole {
  LEAD_ATTORNEY
  ASSOCIATE_ATTORNEY
  PARALEGAL
  STAFF
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum DeadlineType {
  STATUTE_OF_LIMITATIONS
  SPEEDY_TRIAL
  FILING
  OTHER
}

enum DiscoveryFileType {
  PDF
  VIDEO
  AUDIO
  PHOTO
  OTHER
}

enum DiscoveryReviewStatus {
  NOT_STARTED
  IN_REVIEW
  COMPLETE
}

enum DiscoveryMatchStatus {
  NEW
  CHANGED
  DUPLICATE
  MISSING
}

enum CalendarEventType {
  HEARING
  DEPOSITION
  MEETING
  OTHER
  CLIENT_MEETING
  INTERNAL_MEETING
  TRIAL
  CONSULTATION
  VIRTUAL_MEETING
  PHONE_CALL
  FILING_DEADLINE
  DISCOVERY_DEADLINE
}

enum DocumentCategory {
  PLEADING
  CORRESPONDENCE
  CONTRACT
  OTHER
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
}

enum MfaTicketPurpose {
  MFA_PENDING
  MFA_VERIFIED
  MFA_ENROLLMENT
}

enum SecurityIncidentCategory {
  SUSPICIOUS_LOGIN
}

enum SecurityIncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum SecurityIncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

/// Intake providers an `ExternalLeadLink` can come from. One value today;
/// adding a second provider is additive (a new value here plus new
/// `ExternalLeadLink` rows), never a change to `Client` or this enum's
/// existing values.
enum ExternalLeadProvider {
  LOOP_HIGHLEVEL
}

// --- Core entities ---------------------------------------------------------

/// Firm staff account. `passwordHash` is the first authentication factor;
/// `mfaEnabled`/`totpSecretEncrypted`/etc. back an optional TOTP second
/// factor (see lib/auth/mfa/). `mfaRequired` is intentionally separate from
/// `mfaEnabled` so the login flow can tell "not required" apart from
/// "required but not yet enrolled" and route a required-but-unenrolled user
/// into forced setup instead of either granting access or issuing a
/// challenge it can't yet answer.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STAFF)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Bumped (to the current time) on a role change, a status change, or an
  /// admin-initiated password/MFA reset — anything that should end an
  /// already-issued session's authority before its JWT naturally expires.
  /// lib/auth/session.ts#getCurrentUser compares this against the
  /// session's own issued-at time on every call; older-than-this-stamp
  /// sessions are treated as signed out. Null means "never invalidated
  /// since account creation," not "never checked."
  sessionInvalidatedAt DateTime?

  /// Set true only after a successful enrollment confirmation
  /// (lib/auth/mfa/actions.ts) — never set directly.
  mfaEnabled  Boolean @default(false)
  /// Whether this account must enroll in MFA, independent of whether it
  /// has done so yet.
  mfaRequired Boolean @default(false)
  /// AES-256-GCM ciphertext ("iv:authTag:ciphertext", base64) of the TOTP
  /// secret, keyed from MFA_ENCRYPTION_KEY. Null until enrollment is
  /// confirmed; never stored or logged in plaintext.
  totpSecretEncrypted String?
  /// Last TOTP time-step successfully consumed, so a captured still-valid
  /// code can't be replayed within its own window (lib/auth/mfa/totp.ts
  /// enforces this with an atomic conditional update).
  totpLastUsedStep Int?
  /// Consecutive failed second-factor attempts since the last success;
  /// resets to 0 on success. Backs the MFA-step lockout below.
  mfaFailedAttempts Int @default(0)
  /// Set once mfaFailedAttempts crosses the lockout threshold; further
  /// second-factor attempts are refused until this time passes.
  mfaLockedUntil DateTime?
  /// Set true for accounts created with a temporary initial password
  /// (lib/admin/users/actions.ts#createUser). Blocks reaching the app
  /// until cleared by a successful password change — enforced the same
  /// way MFA is: authorize() itself refuses to complete sign-in while
  /// this is true, not just a UI redirect (see lib/auth/login-flow.ts).
  mustChangePassword Boolean @default(false)

  assignments              MatterAssignment[]
  assignedTasks            Task[]                @relation("TaskAssignee")
  authoredNotes            Note[]
  uploadedDocuments        Document[]
  filedCalls               Call[]                @relation("CallFiledBy")
  registeredDiscoveryFiles DiscoveryFile[]       @relation("DiscoveryFileRegisteredBy")
  ranDiscoveryComparisons  DiscoveryComparison[] @relation("DiscoveryComparisonRunBy")
  auditEvents              AuditEvent[]
  archivedClients          Client[]              @relation("ClientArchivedBy")
  archivedMatters          Matter[]              @relation("MatterArchivedBy")
  mfaRecoveryCodes         MfaRecoveryCode[]
  mfaChallengeTickets      MfaChallengeTicket[]
  failedLoginAttempts      FailedLoginAttempt[]
  securityIncidents        SecurityIncident[]
  reviewedIntakeLeads      IntakeLead[]          @relation("IntakeLeadReviewedBy")
  createdContacts             Contact[]             @relation("ContactCreatedBy")
  assignedContacts            Contact[]             @relation("ContactAssignedStaff")
  archivedContacts            Contact[]             @relation("ContactArchivedBy")
  addedMatterContacts         MatterContact[]       @relation("MatterContactAddedBy")
  createdContactRelationships ContactRelationship[] @relation("ContactRelationshipCreatedBy")
  contactInteractions         ContactInteraction[]  @relation("ContactInteractionStaff")
  recordedContactInteractions ContactInteraction[]  @relation("ContactInteractionRecordedBy")
  recordedRulings             JudicialRuling[]          @relation("JudicialRulingRecordedBy")
  authoredObservations        ProfessionalObservation[] @relation("ProfessionalObservationAuthor")
  closureReportsClosed        MatterClosureReport[]     @relation("ClosureReportClosingAttorney")
  closureReportsResponsible   MatterClosureReport[]     @relation("ClosureReportResponsibleAttorney")
  createdCalendarEvents       CalendarEvent[]           @relation("CalendarEventCreatedBy")
  calendarAttendance          CalendarEventAttendee[]
  timeEntries                 TimeEntry[]               @relation("TimeEntryUser")
  activeTimer                 ActiveTimer?
  sessions                    UserSession[]
  activityEvents              UserActivityEvent[]
  activityMinutes             UserActivityMinute[]
  createdConversations        ChatConversation[]        @relation("ChatConversationCreatedBy")
  chatMemberships             ChatMembership[]          @relation("ChatMembershipUser")
  chatMessages                ChatMessage[]             @relation("ChatMessageAuthor")
  workflowTemplatesCreated    WorkflowTemplate[]        @relation("WorkflowTemplateCreatedBy")
  workflowVersionsCreated     WorkflowTemplateVersion[] @relation("WorkflowTemplateVersionCreatedBy")
  workflowStepAssignments     WorkflowTemplateStep[]    @relation("WorkflowStepAssignee")
  workflowApplications        WorkflowApplication[]     @relation("WorkflowApplicationAppliedBy")
  stageChanges                MatterStageChange[]       @relation("MatterStageChangedBy")
  customFieldValueUpdates     CustomFieldValue[]        @relation("CustomFieldValueUpdatedBy")
  savedReports                SavedReport[]             @relation("SavedReportOwner")
  documentVersionsUploaded    DocumentVersion[]         @relation("DocumentVersionUploadedBy")
  documentTemplatesCreated    DocumentTemplate[]        @relation("DocumentTemplateCreatedBy")
  documentTemplateVersions    DocumentTemplateVersion[] @relation("DocumentTemplateVersionCreatedBy")
  notifications               Notification[]            @relation("NotificationRecipient")
  notificationPreferences     NotificationPreference[]  @relation("NotificationPreferenceUser")
  calendarExceptions          CalendarEventException[]  @relation("CalendarExceptionCreatedBy")
  expensesRecorded            Expense[]                 @relation("ExpenseRecordedBy")
  expensesResponsible         Expense[]                 @relation("ExpenseResponsibleUser")
}

/// One-time-use recovery code for bypassing a lost TOTP device. Codes are
/// shown to the user exactly once, at generation time; only a bcrypt hash
/// is persisted (see lib/auth/mfa/recovery-codes.ts) — plaintext never
/// touches the database, logs, or audit metadata. `used` flips exactly
/// once, guarded by a `WHERE used = false` update, so concurrent
/// redemption attempts can't double-spend the same code.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Short-lived, single-use server-side state for the parts of the MFA flow
/// that happen before a real application session exists (password verified,
/// awaiting second factor; second factor verified, awaiting signIn) or that
/// must not touch the User row until confirmed (in-progress enrollment).
/// The browser only ever holds a signed reference to a row's `id`
/// (lib/auth/mfa/tickets.ts) — this table, not the cookie, is the
/// authoritative record of validity, and consumption is an atomic
/// `WHERE consumedAt IS NULL AND expiresAt > now()` update so a ticket
/// cannot be used twice even under concurrent requests. `payload` holds the
/// encrypted pending TOTP secret for MFA_ENROLLMENT tickets only; it is
/// null for every other purpose.
model MfaChallengeTicket {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    MfaTicketPurpose
  payload    String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, purpose])
}

/// A person or entity the firm represents. One Client can have multiple
/// Matters over time (repeat client).
model Client {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  email        String?
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Reversible removal from default active lists/pickers — orthogonal to
  /// any Matter's own `status` (see Matter.archived below). Never cascades:
  /// archiving a Client never touches its Matters (see
  /// lib/clients/actions.ts#archiveClient, which blocks archival while any
  /// Matter of this Client is still OPEN/PENDING).
  archived     Boolean   @default(false)
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("ClientArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  matters           Matter[]
  contact           Contact?
  customFieldValues CustomFieldValue[]
  externalLeadLinks ExternalLeadLink[]
  linkedIntakeLeads IntakeLead[]        @relation("IntakeLeadLinkedClient")
}

/// Durable mapping from one external intake provider's contact/lead id to
/// the Frye `Client` it has been linked to — see lib/intake/linking.ts.
/// Exists specifically so a repeated/retried intake delivery for the same
/// external contact can be recognized before creating a second Client:
/// `@@unique([provider, externalId])` makes that a database-level
/// guarantee, not just an application-level check-then-act. Deliberately a
/// separate model rather than a column on `Client` (e.g.
/// `externalIntakeId`) so a second intake provider can be added later with
/// zero change to `Client` — just a new `ExternalLeadProvider` value and
/// new rows.
model ExternalLeadLink {
  id         String               @id @default(cuid())
  provider   ExternalLeadProvider
  externalId String
  clientId   String
  client     Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  linkedAt   DateTime             @default(now())

  @@unique([provider, externalId])
  @@index([clientId])
}

/// Status of one IntakeLead's staff-review lifecycle — see IntakeLead below.
enum IntakeLeadStatus {
  PENDING
  LINKED
  DISMISSED
}

/// One normalized Loop/HighLevel contact awaiting staff review, created by
/// the intake webhook (see lib/intake/ingest.ts) the first time a given
/// external contact is seen and no ExternalLeadLink for it exists yet.
/// Deliberately stores only the already-normalized fields this app actually
/// needs (see lib/intake/types.ts#NormalizedIntakeLead) — never the raw
/// webhook payload — so an unreviewed lead sitting in this table never
/// accumulates unnecessary PII. `@@unique([provider, externalContactId])`
/// makes a repeated webhook delivery for the same contact update this one
/// row instead of creating duplicates, mirroring ExternalLeadLink's own
/// idempotency boundary one step earlier in the pipeline. Once staff act on
/// it (link to an existing Client, or create a new one), status moves to
/// LINKED and reviewedById/reviewedAt/linkedClientId record the outcome —
/// this row is never deleted, so "what did we do with this lead" stays
/// answerable. Creating/linking the actual Client always goes through the
/// existing, authenticated lib/clients/actions.ts#createClient and
/// lib/intake/linking.ts#linkExternalContactToClient — this table is never
/// itself the source of a Client write.
model IntakeLead {
  id                String               @id @default(cuid())
  provider          ExternalLeadProvider
  externalContactId String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  receivedAt        DateTime
  status            IntakeLeadStatus     @default(PENDING)
  linkedClientId    String?
  linkedClient      Client?              @relation("IntakeLeadLinkedClient", fields: [linkedClientId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?                @relation("IntakeLeadReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([provider, externalContactId])
  @@index([status])
}

/// Singleton persisted state for the pull-based HighLevel contact sync (see
/// lib/intake/highlevelSync.ts) — one row, always looked up by the same
/// fixed id. `lastSuccessfulCheckpoint` is the `dateAdded` of the last
/// contact actually processed in an unbroken top-down walk; it only ever
/// advances to what a run genuinely finished, never past a rate limit,
/// auth failure, or malformed response encountered mid-walk. `runningSince`
/// is a mutex: a run claims it with an atomic conditional update (same
/// pattern as MfaChallengeTicket's atomic consumption) and clears it on
/// exit, so a manual "Sync from Loop" click and the scheduled cron entry
/// point can never process the same window twice concurrently — a `null`
/// or stale (past a short threshold, meaning a prior run crashed without
/// releasing it) value means free to claim. `lastRunOutcome` and the four
/// count fields are a safe summary only — counts, never contact names,
/// emails, phone numbers, or any other PII.
model HighLevelSyncState {
  id                       String    @id @default(cuid())
  lastSuccessfulCheckpoint DateTime?
  lastSuccessfulSyncAt     DateTime?
  lastAttemptedSyncAt      DateTime?
  runningSince             DateTime?
  contactsChecked          Int?
  newLeadsCreated          Int?
  pendingLeadsUpdated      Int?
  linkedOrSkipped          Int?
  failureCount             Int?
  lastRunOutcome           String?
  updatedAt                DateTime  @updatedAt
}

/// A single criminal matter/case for a Client. This is the hub every other
/// entity in this slice hangs off of.
model Matter {
  id           String       @id @default(cuid())
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  caseNumber   String       @unique
  court        String
  charges      String
  status       MatterStatus @default(OPEN)
  openedDate   DateTime
  closedDate   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  /// Reversible removal from default active lists/pickers — orthogonal to
  /// `status`: archiving/reactivating never changes `status`/`closedDate`,
  /// so a reactivated Matter reappears exactly as it was (see
  /// lib/matters/actions.ts#archiveMatter/reactivateMatter). Existing
  /// authorization (`assertMatterAccess`) is unaffected either way — this
  /// only gates default list/picker visibility, never direct access.
  archived     Boolean      @default(false)
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?        @relation("MatterArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  assignments          MatterAssignment[]
  notes                Note[]
  tasks                Task[]
  deadlines            Deadline[]
  calendarEvents       CalendarEvent[]
  discoveryProductions DiscoveryProduction[]
  discoveryComparisons DiscoveryComparison[]
  documents            Document[]
  calls                Call[]
  auditEvents          AuditEvent[]
  contactLinks         MatterContact[]
  contactRelationships ContactRelationship[]
  contactInteractions  ContactInteraction[]
  /// Whether this matter has a structured closure report. Matters already
  /// CLOSED before the closure workflow existed are marked NEEDS_BACKFILL by
  /// the migration — never given a fabricated report.
  closureReviewStatus  ClosureReviewStatus       @default(NOT_APPLICABLE)
  judicialRulings      JudicialRuling[]
  observations         ProfessionalObservation[]
  closureReports       MatterClosureReport[]
  timeEntries          TimeEntry[]
  activeTimers         ActiveTimer[]
  activityEvents       UserActivityEvent[]
  activityMinutes      UserActivityMinute[]
  chatConversations    ChatConversation[]
  chatMessageRefs      ChatMessage[]             @relation("ChatMessageMatterRef")
  stageId              String?
  stage                MatterStage?              @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stageChanges         MatterStageChange[]
  workflowApplications WorkflowApplication[]
  customFieldValues    CustomFieldValue[]
  documentFolders      DocumentFolder[]
  notifications        Notification[]
  expenses             Expense[]
}

/// Join table: which staff are assigned to a Matter, and in what capacity.
/// This is the basis for matter-level authorization (see docs/SECURITY.md)
/// once auth is wired up — a user should only see matters they're assigned
/// to unless they're an admin.
model MatterAssignment {
  id         String         @id @default(cuid())
  matterId   String
  matter     Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  role       AssignmentRole
  assignedAt DateTime       @default(now())

  @@unique([matterId, userId])
}

/// Free-text note attached to a Matter.
model Note {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Actionable to-do attached to a Matter, optionally assigned to a staff
/// member.
model Task {
  id           String       @id @default(cuid())
  matterId     String
  matter       Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// Workflow provenance (never rewritten by later template edits).
  workflowApplicationId  String?
  workflowApplication    WorkflowApplication?  @relation(fields: [workflowApplicationId], references: [id], onDelete: SetNull)
  workflowStepId         String?
  workflowStep           WorkflowTemplateStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  /// Additional in-app reminder offsets before `dueDate`, in minutes.
  reminderOffsetsMinutes Int[]                 @default([])
}

/// A date-driven legal obligation on a Matter (statute of limitations,
/// speedy trial, filing deadline). Kept separate from Task because missing
/// one has legal consequences and needs its own satisfied/audit semantics
/// rather than a generic "done" checkbox.
model Deadline {
  id                 String       @id @default(cuid())
  matterId           String
  matter             Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  type               DeadlineType
  date               DateTime
  description        String
  reminderDaysBefore Int          @default(7)
  satisfied          Boolean      @default(false)
  satisfiedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

/// A scheduled event on a Matter — hearings, depositions, client meetings.
/// Distinct from Deadline: a Deadline is a legal obligation with a
/// satisfied/audit lifecycle, while a CalendarEvent is simply something
/// happening on the calendar (it may have no legal consequence if missed).
///
/// Firm-operations extension: `matterId` is optional so internal meetings
/// can exist without a matter. A matter-linked event keeps the existing
/// matter-scope rule; a matterless event is visible only to ADMIN, its
/// creator, and its staff attendees (lib/calendar/access.ts). Recurrence is
/// a simple rule (frequency/interval/until/count) expanded at read time —
/// no per-occurrence exceptions (see docs/DATA_MODEL.md).
model CalendarEvent {
  id                    String              @id @default(cuid())
  matterId              String?
  matter                Matter?             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title                 String
  type                  CalendarEventType   @default(OTHER)
  startTime             DateTime
  endTime               DateTime?
  location              String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  description           String?
  allDay                Boolean             @default(false)
  timeZone              String              @default("America/New_York")
  status                CalendarEventStatus @default(SCHEDULED)
  meetingUrl            String?
  meetingProvider       MeetingProvider?
  reminderMinutesBefore Int?
  recurrenceFrequency   RecurrenceFrequency @default(NONE)
  recurrenceInterval    Int                 @default(1)
  recurrenceUntil       DateTime?
  recurrenceCount       Int?
  createdById           String?
  createdBy             User?               @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  attendees CalendarEventAttendee[]
  contacts  CalendarEventContact[]

  workflowApplicationId  String?
  workflowApplication    WorkflowApplication?     @relation(fields: [workflowApplicationId], references: [id], onDelete: SetNull)
  workflowStepId         String?
  workflowStep           WorkflowTemplateStep?    @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  /// Additional in-app reminder offsets (minutes); `reminderMinutesBefore` is still honored.
  reminderOffsetsMinutes Int[]                    @default([])
  exceptions             CalendarEventException[]

  @@index([startTime])
  @@index([matterId])
}

/// One batch of discovery received on a Matter. `batesPrefix` is also used
/// as the evidence-ID prefix for non-paginated files registered to it (see
/// lib/discovery/bates.ts). `batesStart`/`batesEnd` are the production-wide
/// Bates range, kept in sync with its files' individual ranges as PDFs are
/// registered (lib/discovery/actions.ts) — they start null and are set once
/// the first PDF is numbered.
model DiscoveryProduction {
  id           String                @id @default(cuid())
  matterId     String
  matter       Matter                @relation(fields: [matterId], references: [id], onDelete: Cascade)
  label        String
  source       String?
  receivedDate DateTime
  batesPrefix  String?
  batesStart   Int?
  batesEnd     Int?
  reviewStatus DiscoveryReviewStatus @default(NOT_STARTED)
  notes        String?
  createdAt    DateTime              @default(now())

  files           DiscoveryFile[]
  comparisonsFrom DiscoveryComparison[] @relation("ComparisonFromProduction")
  comparisonsTo   DiscoveryComparison[] @relation("ComparisonToProduction")
}

/// One file within a DiscoveryProduction. `identifier` holds the assigned
/// Bates range (PDFs, e.g. "ELLIS000001-ELLIS000004") or evidence ID
/// (video/audio/photo/other, e.g. "ELLIS-0001") — see lib/discovery/bates.ts.
/// `originalStorageKey` always points at the untouched original bytes;
/// `stampedStorageKey` is set only for PDFs and points at a *separate*
/// Bates-stamped derivative — the original is never modified in place (see
/// docs/ARCHITECTURE.md's "Discovery management" section). Both keys are
/// opaque to `lib/storage/DocumentStore`'s current local-disk
/// implementation and will resolve the same way once that's swapped for a
/// Dropbox-backed one.
model DiscoveryFile {
  id                 String              @id @default(cuid())
  productionId       String
  production         DiscoveryProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  originalFilename   String
  identifier         String?
  fileType           DiscoveryFileType
  contentHash        String?
  originalStorageKey String?
  stampedStorageKey  String?
  pageCount          Int?
  batesStart         Int?
  batesEnd           Int?
  sizeBytes          Int?
  mimeType           String?
  registeredById     String?
  registeredBy       User?               @relation("DiscoveryFileRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  registeredAt       DateTime?
  createdAt          DateTime            @default(now())

  matches DiscoveryFileMatch[]
}

/// A production-to-production comparison run — real as of the fifth
/// session (see docs/ROADMAP.md): `lib/discovery/compare.ts` classifies
/// each file by content hash and filename, and `lib/discovery/actions.ts`
/// persists the result as DiscoveryFileMatch rows. Comparisons created
/// before that session were seeded by hand and remain as illustrative
/// historical data — `runById` is null for those.
model DiscoveryComparison {
  id               String              @id @default(cuid())
  matterId         String
  matter           Matter              @relation(fields: [matterId], references: [id], onDelete: Cascade)
  fromProductionId String
  fromProduction   DiscoveryProduction @relation("ComparisonFromProduction", fields: [fromProductionId], references: [id])
  toProductionId   String
  toProduction     DiscoveryProduction @relation("ComparisonToProduction", fields: [toProductionId], references: [id])
  runById          String?
  runBy            User?               @relation("DiscoveryComparisonRunBy", fields: [runById], references: [id], onDelete: SetNull)
  runAt            DateTime            @default(now())

  matches DiscoveryFileMatch[]
}

/// One row of a DiscoveryComparison result: how a given filename fared
/// between the "from" and "to" productions. `fileId` points at the
/// DiscoveryFile it refers to when one exists (absent for MISSING rows,
/// since by definition the file isn't in the newer production).
model DiscoveryFileMatch {
  id           String               @id @default(cuid())
  comparisonId String
  comparison   DiscoveryComparison  @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  status       DiscoveryMatchStatus
  filename     String
  identifier   String?
  fileId       String?
  file         DiscoveryFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  notes        String?
}

/// A general (non-discovery) document tied to a Matter — pleadings,
/// correspondence, contracts. `storageKey` is an opaque
/// `lib/storage/DocumentStore` key (local disk today, a Dropbox test
/// folder if `STORAGE_PROVIDER=dropbox` — see docs/ARCHITECTURE.md), not a
/// literal Dropbox API path; it's named generically on purpose so the
/// storage backend can change without a schema change. Renamed from
/// `dropboxPath` and given `originalFilename`/`mimeType`/`sizeBytes`/
/// `contentHash` (tenth session, real upload/download support) — rows
/// seeded before that session keep their old illustrative path strings in
/// `storageKey` with the four new columns left null, since nothing is
/// actually stored behind them (same pattern as DiscoveryFile rows seeded
/// before the real Bates engine).
model Document {
  id               String           @id @default(cuid())
  matterId         String
  matter           Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  category         DocumentCategory @default(OTHER)
  title            String
  storageKey       String
  originalFilename String?
  mimeType         String?
  sizeBytes        Int?
  contentHash      String?
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime         @default(now())
  notes            String?

  judicialRulings JudicialRuling[]
  chatMessageRefs ChatMessage[]    @relation("ChatMessageDocumentRef")

  folderId                      String?
  folder                        DocumentFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags                          String[]                 @default([])
  /// Mirrors the current DocumentVersion; storage columns above always
  /// describe that version so existing links keep working.
  currentVersionId              String?                  @unique
  currentVersion                DocumentVersion?         @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions                      DocumentVersion[]        @relation("DocumentVersions")
  generatedFromTemplateVersionId String?
  generatedFromTemplateVersion  DocumentTemplateVersion? @relation("DocumentGeneratedFrom", fields: [generatedFromTemplateVersionId], references: [id], onDelete: SetNull)
  expenseReceipts               Expense[]                @relation("ExpenseReceipt")
}

/// A phone call. `matterId` is nullable to represent the "unfiled call"
/// state (received, not yet attached to a matter) from the planned Vonage
/// workflow — no telephony integration exists yet; rows here are manually
/// logged or seeded. `vonageCallId` is `@unique` (Postgres treats every
/// `NULL` as distinct, so every manually-logged call — which never sets
/// it — is unaffected) so a duplicate/retried Vonage webhook delivery for
/// the same external call can never create two rows: the second insert
/// fails the constraint instead of racing a check-then-act read (see
/// lib/telephony/ingest.ts).
model Call {
  id                   String        @id @default(cuid())
  matterId             String?
  matter               Matter?       @relation(fields: [matterId], references: [id], onDelete: SetNull)
  contactName          String?
  /// Optional link to the Contact directory so a logged call appears on
  /// that contact's interaction timeline without a second copy of it.
  /// `contactName` stays for calls with no directory entry.
  contactId            String?
  contact              Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  vonageCallId         String?       @unique
  direction            CallDirection
  fromNumber           String
  toNumber             String
  occurredAt           DateTime
  durationSeconds      Int
  recordingDropboxPath String?
  flagged              Boolean       @default(false)
  notes                String?
  filedById            String?
  filedBy              User?         @relation("CallFiledBy", fields: [filedById], references: [id], onDelete: SetNull)
  filedAt              DateTime?
  createdAt            DateTime      @default(now())
}

/// Immutable log of who did what to which record and when (see CLAUDE.md,
/// section 4.5 — every write to case data must produce one of these). No
/// update/delete should ever be exposed for this model at the application
/// layer. `matterId` is a nullable, denormalized pointer for fast
/// "everything on this matter" queries and is set to null (not cascaded)
/// if the matter is ever removed, so the historical record survives.
model AuditEvent {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  matterId   String?
  matter     Matter?     @relation(fields: [matterId], references: [id], onDelete: SetNull)
  metadata   Json?
  occurredAt DateTime    @default(now())
  ipAddress  String?
}

/// A single failed password-verification attempt, recorded purely for
/// suspicious-login detection (lib/security/detection.ts) — never stores
/// the attempted password or any other credential material. `accountId` is
/// set only when the attempted email matched an existing User row, so the
/// windowed per-account count used for detection is keyed to a real
/// account; attempts against an unrecognized email are still recorded
/// (`accountId` null) but never count toward that threshold and never
/// create a User row.
model FailedLoginAttempt {
  id             String   @id @default(cuid())
  accountId      String?
  account        User?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  emailAttempted String
  occurredAt     DateTime @default(now())
  ipAddress      String?

  @@index([accountId, occurredAt])
}

/// A detected suspicious-authentication event and its admin triage
/// lifecycle (see docs/SECURITY.md). Created automatically once
/// `lib/security/detection.ts` sees `failedAttemptCount` FailedLoginAttempt
/// rows for the same account inside one detection window; `status`
/// thereafter only ever changes through an ADMIN-only Server Action
/// (lib/security/actions.ts), forward-only: OPEN -> INVESTIGATING ->
/// RESOLVED|FALSE_POSITIVE. `notes` is admin-entered triage commentary —
/// never populated with client, discovery, or communication content.
model SecurityIncident {
  id                 String                   @id @default(cuid())
  category           SecurityIncidentCategory
  severity           SecurityIncidentSeverity
  status             SecurityIncidentStatus   @default(OPEN)
  accountId          String?
  account            User?                    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  failedAttemptCount Int
  windowStart        DateTime
  windowEnd          DateTime
  detectedAt         DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  notes              String?

  @@index([status])
}

// --- Contacts --------------------------------------------------------------
//
// The firm-wide contact directory (see docs/FIRM_OPERATIONS_EXPANSION.md).
// Visibility is strictly matter-derived — there is no stored visibility
// flag: a Contact is visible to ADMIN, to its creator, and to anyone who
// can access a matter it's actively linked to (via MatterContact, or via
// its linked Client's own matters). See lib/contacts/visibility.ts.

enum ContactKind {
  INDIVIDUAL
  ORGANIZATION
}

/// Criminal-defense contact categories. Multi-valued on Contact (a person
/// can be a witness on one matter and a family member on another), and
/// reused as the per-matter role on MatterContact. "Current client" and
/// "former client" are deliberately absent: they're derived from a linked
/// Client's matter statuses, never stored.
enum ContactCategory {
  PROSPECTIVE_CLIENT
  JUDGE
  PROSECUTOR
  ASSISTANT_DISTRICT_ATTORNEY
  SOLICITOR
  DEFENSE_ATTORNEY
  OPPOSING_COUNSEL
  POLICE_OFFICER
  DETECTIVE
  SHERIFF_DEPUTY
  LAW_ENFORCEMENT_AGENCY
  COURT_CLERK
  COURT_ADMINISTRATOR
  PROBATION_OFFICER
  INVESTIGATOR
  EXPERT_WITNESS
  WITNESS
  CO_DEFENDANT
  FAMILY_MEMBER
  EMERGENCY_CONTACT
  INTERPRETER
  BAIL_BONDSMAN
  CORRECTIONAL_FACILITY_CONTACT
  VENDOR
  OTHER_PROFESSIONAL
}

enum PreferredContactMethod {
  PHONE
  TEXT
  EMAIL
  MAIL
  IN_PERSON
}

/// Direction-sensitive: a ContactRelationship reads "from is <type> of to"
/// (e.g. "Pat Doe is PARENT of Jane Doe").
enum ContactRelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  FAMILY_MEMBER
  EMPLOYER
  EMPLOYEE
  WITNESS
  CO_DEFENDANT
  ARRESTING_OFFICER
  INVESTIGATING_DETECTIVE
  ASSIGNED_PROSECUTOR
  ASSIGNED_JUDGE
  EXPERT_WITNESS
  DEFENSE_INVESTIGATOR
  OTHER
}

enum ContactRelationshipScope {
  PERMANENT
  MATTER
}

enum ContactInteractionType {
  CALL
  MEETING
  EMAIL
  NOTE
  COURT_APPEARANCE
  CONSULTATION
  FOLLOW_UP
}

enum FollowUpStatus {
  NONE
  PENDING
  COMPLETED
}

/// One person or organization the firm has encountered, kept permanently —
/// it survives the closing or archiving of every matter it's linked to.
/// `displayName` is derived on write ("First Last" for individuals, the
/// organization name otherwise) so search and sorting work for both kinds.
/// A Contact linked to a Client (`clientId`) is that client's directory
/// entry: its names are kept in sync from the Client record, and the
/// client's own email/phone/address stay on Client rather than being
/// copied here. `court`/`jurisdiction`/`position` describe professional
/// contacts (judges, prosecutors, clerks).
model Contact {
  id                     String                  @id @default(cuid())
  kind                   ContactKind             @default(INDIVIDUAL)
  firstName              String?
  lastName               String?
  displayName            String
  organizationId         String?
  organization           Contact?                @relation("ContactOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  members                Contact[]               @relation("ContactOrganization")
  jobTitle               String?
  categories             ContactCategory[]
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  postalCode             String?
  preferredContactMethod PreferredContactMethod?
  notes                  String?
  court                  String?
  jurisdiction           String?
  position               String?
  clientId               String?                 @unique
  client                 Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedStaffId        String?
  assignedStaff          User?                   @relation("ContactAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lastContactedAt        DateTime?
  createdById            String?
  createdBy              User?                   @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archived               Boolean                 @default(false)
  archivedAt             DateTime?
  archivedById           String?
  archivedBy             User?                   @relation("ContactArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  phones               ContactPhone[]
  emails               ContactEmail[]
  matterLinks          MatterContact[]
  rulingsAsJudge       JudicialRuling[]          @relation("JudicialRulingJudge")
  observationsAbout    ProfessionalObservation[] @relation("ProfessionalObservationSubject")
  closuresAsJudge      MatterClosureReport[]     @relation("ClosureReportJudge")
  closuresAsProsecutor MatterClosureReport[]     @relation("ClosureReportProsecutor")
  closuresAsOpposing   MatterClosureReport[]     @relation("ClosureReportOpposingCounsel")
  calendarEvents       CalendarEventContact[]
  customFieldValues    CustomFieldValue[]
  relationshipsFrom    ContactRelationship[] @relation("ContactRelationshipFrom")
  relationshipsTo      ContactRelationship[] @relation("ContactRelationshipTo")
  interactions         ContactInteraction[]
  calls                Call[]

  @@index([displayName])
  @@index([lastName, firstName])
  @@index([organizationId])
  @@index([createdById])
}

model ContactPhone {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String?
  number    String
  isPrimary Boolean @default(false)

  @@index([contactId])
  @@index([number])
}

model ContactEmail {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String?
  address   String
  isPrimary Boolean @default(false)

  @@index([contactId])
  @@index([address])
}

/// Which Contacts are involved in a Matter, and in what role. Removing a
/// contact from a matter sets `removedAt` instead of deleting the row, so
/// the history of who was involved survives; re-adding the same contact in
/// the same role clears it again (hence the unique key). A removed link
/// grants no visibility.
model MatterContact {
  id         String          @id @default(cuid())
  matterId   String
  matter     Matter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role       ContactCategory
  roleDetail String?
  startDate  DateTime?
  endDate    DateTime?
  addedById  String?
  addedBy    User?           @relation("MatterContactAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt    DateTime        @default(now())
  removedAt  DateTime?

  @@unique([matterId, contactId, role])
  @@index([contactId])
}

/// A relationship between two Contacts ("Pat Doe is PARENT of Jane Doe").
/// PERMANENT relationships are personal facts independent of any case;
/// MATTER-scoped ones (an arresting officer, a co-defendant) require
/// `matterId` and are only visible to users with access to that matter.
model ContactRelationship {
  id            String                   @id @default(cuid())
  fromContactId String
  fromContact   Contact                  @relation("ContactRelationshipFrom", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContactId   String
  toContact     Contact                  @relation("ContactRelationshipTo", fields: [toContactId], references: [id], onDelete: Cascade)
  type          ContactRelationshipType
  scope         ContactRelationshipScope @default(PERMANENT)
  matterId      String?
  matter        Matter?                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  context       String?
  createdById   String?
  createdBy     User?                    @relation("ContactRelationshipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                 @default(now())

  @@index([fromContactId])
  @@index([toContactId])
}

/// A manually recorded interaction with a Contact (meeting, email, court
/// appearance, ...). Phone calls already logged as `Call` rows link via
/// `Call.contactId` instead of being copied here; the contact timeline
/// merges both. Only something that actually happened belongs here — a
/// scheduled event is not an interaction.
model ContactInteraction {
  id             String                 @id @default(cuid())
  contactId      String
  contact        Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  matterId       String?
  matter         Matter?                @relation(fields: [matterId], references: [id], onDelete: SetNull)
  type           ContactInteractionType
  occurredAt     DateTime
  staffId        String?
  staff          User?                  @relation("ContactInteractionStaff", fields: [staffId], references: [id], onDelete: SetNull)
  summary        String
  outcome        String?
  followUpStatus FollowUpStatus         @default(NONE)
  recordedById   String?
  recordedBy     User?                  @relation("ContactInteractionRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())

  @@index([contactId, occurredAt])
  @@index([matterId])
}

// --- Professional history & matter closure -----------------------------------
//
// Rulings and observations are always owned by (and authorized through) a
// matter, except firm-wide reference notes, which by construction carry no
// matter at all. See lib/history/ and docs/SECURITY.md, "Professional
// history".

enum ProceedingType {
  ARRAIGNMENT
  BOND_HEARING
  MOTION_HEARING
  PRETRIAL_CONFERENCE
  PLEA_HEARING
  TRIAL
  SENTENCING
  PROBATION_HEARING
  OTHER
}

enum RulingIssueType {
  MOTION_TO_SUPPRESS
  MOTION_TO_DISMISS
  BOND_MODIFICATION
  DISCOVERY_MOTION
  EVIDENTIARY_MOTION
  CONTINUANCE
  SENTENCING
  PROBATION_MOTION
  JURY_INSTRUCTION
  OTHER_MOTION
}

enum RulingResult {
  GRANTED
  DENIED
  PARTIALLY_GRANTED
  WITHDRAWN
  MOOT
  TAKEN_UNDER_ADVISEMENT
  OTHER
}

/// A recorded court ruling — a verified fact about a proceeding, distinct
/// from an attorney's opinion (ProfessionalObservation). Corrections never
/// overwrite: a correction is a new row whose `supersedesId` points at the
/// row it replaces, which gets `supersededAt`; the "current" ruling is the
/// one with `supersededAt` null. `supersedesId @unique` keeps each
/// revision chain linear.
model JudicialRuling {
  id               String          @id @default(cuid())
  matterId         String
  matter           Matter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  judgeContactId   String
  judge            Contact         @relation("JudicialRulingJudge", fields: [judgeContactId], references: [id])
  rulingDate       DateTime
  court            String
  proceedingType   ProceedingType
  issueType        RulingIssueType
  issueDetail      String?
  result           RulingResult
  context          String?
  documentId       String?
  document         Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  closureReportId  String?
  closureReport    MatterClosureReport? @relation(fields: [closureReportId], references: [id], onDelete: SetNull)
  recordedById     String?
  recordedBy       User?           @relation("JudicialRulingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  version          Int             @default(1)
  supersedesId     String?         @unique
  supersedes       JudicialRuling? @relation("JudicialRulingRevisions", fields: [supersedesId], references: [id])
  supersededBy     JudicialRuling? @relation("JudicialRulingRevisions")
  supersededAt     DateTime?
  correctionReason String?

  @@index([judgeContactId, supersededAt])
  @@index([matterId])
}

enum ObservationKind {
  PROCEDURAL_OBSERVATION
  SUBJECTIVE_IMPRESSION
  LESSON_LEARNED
}

enum ObservationCategory {
  HEARING_PROCEDURE
  SCHEDULING
  COURTROOM_MANAGEMENT
  EVIDENTIARY
  LEGAL_ISSUE
  NEGOTIATION
  COMMUNICATION
  PREPARATION
  OTHER
}

/// MATTER_ONLY observations require a matter and follow that matter's
/// access. FIRM_ATTORNEYS reference notes are an explicit sharing choice,
/// visible to ADMIN/ATTORNEY users who can see the subject contact, and
/// never carry a matter (so they can't disclose one).
enum ObservationShareScope {
  MATTER_ONLY
  FIRM_ATTORNEYS
}

/// An attorney's professional note about a judge, prosecutor, solicitor,
/// or opposing counsel. `kind` keeps observations, subjective impressions,
/// and lessons learned explicitly labelled as opinion, never presented as
/// verified fact. Versioned exactly like JudicialRuling.
model ProfessionalObservation {
  id               String                   @id @default(cuid())
  subjectContactId String
  subject          Contact                  @relation("ProfessionalObservationSubject", fields: [subjectContactId], references: [id])
  matterId         String?
  matter           Matter?                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?                    @relation("ProfessionalObservationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category         ObservationCategory
  kind             ObservationKind
  body             String
  references       String?
  shareScope       ObservationShareScope    @default(MATTER_ONLY)
  closureReportId  String?
  closureReport    MatterClosureReport?     @relation(fields: [closureReportId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  version          Int                      @default(1)
  supersedesId     String?                  @unique
  supersedes       ProfessionalObservation? @relation("ProfessionalObservationRevisions", fields: [supersedesId], references: [id])
  supersededBy     ProfessionalObservation? @relation("ProfessionalObservationRevisions")
  supersededAt     DateTime?
  correctionReason String?

  @@index([subjectContactId, supersededAt])
  @@index([matterId])
}

enum ClosureReviewStatus {
  NOT_APPLICABLE
  NEEDS_BACKFILL
  COMPLETE
}

enum CaseDisposition {
  DISMISSAL
  ACQUITTAL
  CONVICTION
  PLEA_AGREEMENT
  DIVERSION
  NOLLE_PROSEQUI
  DEFERRED_ADJUDICATION
  ADMINISTRATIVE_CLOSURE
  OTHER
}

enum ResolutionProcedure {
  TRIAL
  PLEA
  DISMISSAL
  DIVERSION
  OTHER
}

/// Structured outcome report written when a matter is closed (or
/// backfilled for a matter closed before this existed). Versioned: an
/// amendment is a new row with the next `version`, and the previous row
/// gets `supersededAt` — nothing is overwritten.
model MatterClosureReport {
  id                       String               @id @default(cuid())
  matterId                 String
  matter                   Matter               @relation(fields: [matterId], references: [id], onDelete: Cascade)
  version                  Int
  supersededAt             DateTime?
  amendmentReason          String?
  isHistoricalBackfill     Boolean              @default(false)
  responsibleAttorneyId    String?
  responsibleAttorney      User?                @relation("ClosureReportResponsibleAttorney", fields: [responsibleAttorneyId], references: [id], onDelete: SetNull)
  closingAttorneyId        String?
  closingAttorney          User?                @relation("ClosureReportClosingAttorney", fields: [closingAttorneyId], references: [id], onDelete: SetNull)
  closureDate              DateTime
  caseType                 String?
  charges                  String
  disposition              CaseDisposition
  dispositionDetail        String?
  outcomeDate              DateTime?
  resolutionProcedure      ResolutionProcedure
  outcomeSummary           String
  judgeContactId           String?
  judge                    Contact?             @relation("ClosureReportJudge", fields: [judgeContactId], references: [id], onDelete: SetNull)
  prosecutorContactId      String?
  prosecutor               Contact?             @relation("ClosureReportProsecutor", fields: [prosecutorContactId], references: [id], onDelete: SetNull)
  opposingCounselContactId String?
  opposingCounsel          Contact?             @relation("ClosureReportOpposingCounsel", fields: [opposingCounselContactId], references: [id], onDelete: SetNull)
  noSignificantRulings     Boolean              @default(false)
  exceptionReason          String?
  finalNotes               String?
  lessonsLearned           String?
  createdAt                DateTime             @default(now())

  trialOutcome TrialOutcome?
  rulings      JudicialRuling[]
  observations ProfessionalObservation[]

  @@unique([matterId, version])
}

enum TrialType {
  BENCH
  JURY
}

/// Trial details for a closure report whose resolution was a trial.
/// `verdicts` is a Zod-validated JSON array of { charge, verdict }.
model TrialOutcome {
  id                   String              @id @default(cuid())
  closureReportId      String              @unique
  closureReport        MatterClosureReport @relation(fields: [closureReportId], references: [id], onDelete: Cascade)
  trialStartDate       DateTime
  trialEndDate         DateTime?
  trialType            TrialType
  defenseAttorneys     String?
  chargesTried         String
  verdicts             Json
  evidentiaryIssues    String?
  significantMotions   String?
  sentencingOutcome    String?
  trialSummary         String
  attorneyObservations String?
  lessonsLearned       String?
}

// --- Calendar ------------------------------------------------------------------

enum CalendarEventStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MeetingProvider {
  ZOOM
  MICROSOFT_TEAMS
  GOOGLE_MEET
  WEBEX
  OTHER
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

/// Firm staff attending a CalendarEvent. Attendance also grants visibility
/// of a matterless (internal) event; a matter-linked event still requires
/// matter access.
model CalendarEventAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

/// Directory contacts linked to a CalendarEvent (client, witness, ...).
model CalendarEventContact {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactId])
  @@index([contactId])
}

// --- Time tracking ---------------------------------------------------------------

enum TimeActivityCategory {
  LEGAL_RESEARCH
  DISCOVERY_REVIEW
  DOCUMENT_REVIEW
  DRAFTING
  COURT_PREPARATION
  COURT_APPEARANCE
  TRIAL_WORK
  CLIENT_COMMUNICATION
  CONSULTATION
  WITNESS_INTERVIEW
  INVESTIGATION
  INTERNAL_DISCUSSION
  ADMINISTRATIVE
  OTHER
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

/// Work time an employee actually recorded against a matter. Entirely
/// separate from inferred application usage (UserActivityMinute) — nothing
/// ever converts usage into a TimeEntry. Corrections are edits audited
/// field-by-field; removal is a void (`voidedAt` + reason), never a delete.
/// `hourlyRateCents` is optional and monetary amounts are ADMIN-only; no
/// invoicing exists (CLAUDE.md).
model TimeEntry {
  id              String               @id @default(cuid())
  matterId        String
  matter          Matter               @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId          String
  user            User                 @relation("TimeEntryUser", fields: [userId], references: [id])
  workDate        DateTime
  durationMinutes Int
  startedAt       DateTime?
  endedAt         DateTime?
  category        TimeActivityCategory
  description     String
  billable        Boolean              @default(true)
  hourlyRateCents Int?
  status          TimeEntryStatus      @default(SUBMITTED)
  source          TimeEntrySource      @default(MANUAL)
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([matterId, workDate])
  @@index([userId, workDate])
}

/// The single running (or paused) matter timer per user — persisted so it
/// survives reloads, closed tabs, and restarts. Stopping it produces a
/// DRAFT TimeEntry the user confirms; nothing is committed silently.
model ActiveTimer {
  id                 String                @id @default(cuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId           String
  matter             Matter                @relation(fields: [matterId], references: [id], onDelete: Cascade)
  category           TimeActivityCategory?
  description        String?
  startedAt          DateTime
  runningSince       DateTime?
  accumulatedSeconds Int                   @default(0)
}

// --- Usage analytics -------------------------------------------------------------

enum SessionEndReason {
  LOGOUT
  EXPIRED
  REVOKED
  UNKNOWN
}

/// One authenticated session (id carried in the JWT as `sid`). `endedAt` is
/// set on logout or when a maintenance pass finds it past the JWT lifetime;
/// active time is estimated from UserActivityMinute, never measured.
model UserSession {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime          @default(now())
  lastSeenAt DateTime          @default(now())
  endedAt    DateTime?
  endReason  SessionEndReason?
  ipAddress  String?
  userAgent  String?

  activityEvents  UserActivityEvent[]
  activityMinutes UserActivityMinute[]

  @@index([userId, startedAt])
}

enum ActivityEventType {
  LOGIN_SUCCESS
  LOGOUT
  SESSION_START
  SESSION_EXPIRED
  PAGE_VIEW
  MATTER_VIEW
  DOCUMENT_DOWNLOAD
  REPORT_EXPORT
  DATA_CHANGE
  ADMIN_ACTION
  ACCESS_DENIED
}

enum ActivityResult {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only usage event. Carries a module, a sanitized route path, and
/// safe identifiers only — never content, tokens, passwords, or free text.
/// Failed logins stay in FailedLoginAttempt (the security center's source).
model UserActivityEvent {
  id           String            @id @default(cuid())
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId    String?
  session      UserSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type         ActivityEventType
  module       String?
  path         String?
  matterId     String?
  matter       Matter?           @relation(fields: [matterId], references: [id], onDelete: SetNull)
  resourceType String?
  resourceId   String?
  result       ActivityResult    @default(SUCCESS)
  occurredAt   DateTime          @default(now())

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
}

/// One row per user per active minute, written by the client heartbeat only
/// while a tab is visible and recently interacted with. The unique key
/// collapses several tabs/devices into one minute, so overlapping activity
/// is never double-counted. Estimated active time = count of rows.
model UserActivityMinute {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  minute    DateTime
  sessionId String?
  session   UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  module    String?
  matterId  String?
  matter    Matter?      @relation(fields: [matterId], references: [id], onDelete: SetNull)

  @@unique([userId, minute])
  @@index([minute])
}

// --- Team chat -------------------------------------------------------------------

enum ChatConversationType {
  CHANNEL
  DIRECT
  GROUP
}

enum ChatChannelKind {
  MATTER
  TEAM
  DEPARTMENT
  GENERAL
  TOPIC
}

/// A channel, direct message, or group DM. DIRECT/GROUP conversations carry
/// `participantKey` (sorted member ids) so the same set of people always
/// resolves to the same conversation; their membership is fixed at
/// creation. A matter-linked channel additionally requires matter access on
/// every read, so revoking matter access revokes the channel.
model ChatConversation {
  id             String               @id @default(cuid())
  type           ChatConversationType
  name           String?
  description    String?
  channelKind    ChatChannelKind?
  matterId       String?
  matter         Matter?              @relation(fields: [matterId], references: [id], onDelete: Cascade)
  participantKey String?              @unique
  createdById    String?
  createdBy      User?                @relation("ChatConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt     DateTime?
  lastMessageAt  DateTime?
  createdAt      DateTime             @default(now())

  memberships ChatMembership[]
  messages    ChatMessage[]

  @@index([matterId])
}

/// Conversation membership plus per-member read state (`lastReadAt`).
/// Leaving or removal sets `leftAt` rather than deleting, so message
/// authorship history stays intact.
model ChatMembership {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("ChatMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  isOwner        Boolean          @default(false)
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

/// A chat message. Edits set `editedAt`; deletion is soft (`deletedAt`,
/// body hidden on read). Matter/document references are re-authorized on
/// every read — a reference never grants access by itself.
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?            @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  parentId       String?
  parent         ChatMessage?     @relation("ChatMessageThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]    @relation("ChatMessageThread")
  matterRefId    String?
  matterRef      Matter?          @relation("ChatMessageMatterRef", fields: [matterRefId], references: [id], onDelete: SetNull)
  documentRefId  String?
  documentRef    Document?        @relation("ChatMessageDocumentRef", fields: [documentRefId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
}

// --- MyCase parity pass (docs/MYCASE_PARITY_SCHEMA_PROPOSAL.md, domains A–H) ---

// A. Workflow templates ---------------------------------------------------------

enum WorkflowCategory {
  RETAINED_CLIENT_SETUP
  DISCOVERY_REVIEW
  HEARING_PREPARATION
  TRIAL_PREPARATION
  CLOSURE_FOLLOW_UP
  OTHER
}

enum WorkflowTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum WorkflowStepKind {
  TASK
  EVENT
}

enum WorkflowAssigneeRule {
  UNASSIGNED
  LEAD_ATTORNEY
  ASSIGNED_PARALEGAL
  SPECIFIC_USER
}

/// A reusable, ADMIN-managed checklist of task/event steps applied to a
/// matter. Editing creates a new immutable WorkflowTemplateVersion, so
/// previously applied workflows always reference exactly what was used.
model WorkflowTemplate {
  id          String                 @id @default(cuid())
  name        String
  description String?
  category    WorkflowCategory       @default(OTHER)
  status      WorkflowTemplateStatus @default(ACTIVE)
  createdById String?
  createdBy   User?                  @relation("WorkflowTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  versions WorkflowTemplateVersion[]
}

model WorkflowTemplateVersion {
  id          String           @id @default(cuid())
  templateId  String
  template    WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  createdById String?
  createdBy   User?            @relation("WorkflowTemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  steps        WorkflowTemplateStep[]
  applications WorkflowApplication[]

  @@unique([templateId, version])
}

/// One ordered step. `offsetDays` are plain calendar days from the
/// application's anchor date — never a court-rule or business-day
/// computation, and never a legal Deadline.
model WorkflowTemplateStep {
  id              String               @id @default(cuid())
  versionId       String
  version         WorkflowTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position        Int
  kind            WorkflowStepKind
  title           String
  description     String?
  priority        TaskPriority         @default(NORMAL)
  offsetDays      Int
  timeOfDay       String?
  durationMinutes Int?
  eventType       CalendarEventType?
  assigneeRule    WorkflowAssigneeRule @default(UNASSIGNED)
  assigneeUserId  String?
  assigneeUser    User?                @relation("WorkflowStepAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  tasks  Task[]
  events CalendarEvent[]

  @@unique([versionId, position])
}

/// One application of a template version to a matter. `requestKey` is
/// generated per form submission, so a retried submit is a no-op while a
/// deliberate second application (new key) is allowed even for the same
/// template and anchor.
model WorkflowApplication {
  id                String                  @id @default(cuid())
  matterId          String
  matter            Matter                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  templateVersionId String
  templateVersion   WorkflowTemplateVersion @relation(fields: [templateVersionId], references: [id])
  anchorDate        DateTime
  timeZone          String
  requestKey        String                  @unique
  appliedById       String?
  appliedBy         User?                   @relation("WorkflowApplicationAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  recalculatedAt    DateTime?

  tasks  Task[]
  events CalendarEvent[]

  @@index([matterId])
}

// B. Case stages ------------------------------------------------------------------

/// A configurable progress stage (Investigation, Discovery, ...). Entirely
/// separate from Matter.status / archive / closure: changing a stage never
/// closes or reopens a matter.
model MatterStage {
  id         String    @id @default(cuid())
  name       String
  position   Int
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  matters     Matter[]
  changesFrom MatterStageChange[] @relation("StageChangeFrom")
  changesTo   MatterStageChange[] @relation("StageChangeTo")
}

model MatterStageChange {
  id          String       @id @default(cuid())
  matterId    String
  matter      Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  fromStageId String?
  fromStage   MatterStage? @relation("StageChangeFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId   String?
  toStage     MatterStage? @relation("StageChangeTo", fields: [toStageId], references: [id], onDelete: SetNull)
  changedById String?
  changedBy   User?        @relation("MatterStageChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime     @default(now())

  @@index([matterId, changedAt])
}

// C. Custom fields ----------------------------------------------------------------

enum CustomFieldEntity {
  MATTER
  CONTACT
  CLIENT
}

enum CustomFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATE
  SINGLE_SELECT
}

/// ADMIN-defined extra field. `type` is immutable once values exist, and
/// select options (`options`: [{ id, label, archived }]) are retired rather
/// than deleted, so stored values never become unreadable.
model CustomFieldDefinition {
  id         String            @id @default(cuid())
  entity     CustomFieldEntity
  key        String
  label      String
  helpText   String?
  type       CustomFieldType
  options    Json?
  position   Int               @default(0)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())

  values CustomFieldValue[]

  @@unique([entity, key])
}

/// One typed value. Exactly one owner column is set, matching the
/// definition's entity; exactly one value column is set, matching its type.
model CustomFieldValue {
  id            String                @id @default(cuid())
  definitionId  String
  definition    CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  matterId      String?
  matter        Matter?               @relation(fields: [matterId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  valueText     String?
  valueNumber   Decimal?              @db.Decimal(18, 4)
  valueBoolean  Boolean?
  valueDate     DateTime?
  valueOptionId String?
  updatedById   String?
  updatedBy     User?                 @relation("CustomFieldValueUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime              @updatedAt

  @@unique([definitionId, matterId])
  @@unique([definitionId, contactId])
  @@unique([definitionId, clientId])
}

// D. Saved reports ----------------------------------------------------------------

enum SavedReportKind {
  MATTERS
  TASKS
  TIME
  USAGE
  SEARCH
  EXPENSES
}

/// A saved filter configuration — never saved results or privileges. It is
/// re-scoped to whoever runs it, every time.
model SavedReport {
  id        String          @id @default(cuid())
  ownerId   String
  owner     User            @relation("SavedReportOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  kind      SavedReportKind
  filters   Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([ownerId])
}

// E. Document workflows -----------------------------------------------------------

model DocumentFolder {
  id        String           @id @default(cuid())
  matterId  String
  matter    Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    DocumentFolder?  @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("DocumentFolderTree")
  position  Int              @default(0)
  createdAt DateTime         @default(now())

  documents Document[]

  @@unique([matterId, parentId, name])
}

/// Reusable folder layout (e.g. "Criminal defense standard") applied to a
/// matter; applying creates only missing folders.
model DocumentFolderSet {
  id         String                  @id @default(cuid())
  name       String
  archivedAt DateTime?
  createdAt  DateTime                @default(now())

  items DocumentFolderSetItem[]
}

model DocumentFolderSetItem {
  id       String            @id @default(cuid())
  setId    String
  set      DocumentFolderSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  path     String
  position Int

  @@unique([setId, path])
}

/// Append-only version of a general Document's bytes. The Document's own
/// storage columns mirror its current version, so existing download links
/// and references keep working; earlier versions stay downloadable.
model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  document         Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  storageKey       String
  originalFilename String?
  mimeType         String?
  sizeBytes        Int?
  contentHash      String?
  uploadedById     String?
  uploadedBy       User?    @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  currentFor Document?          @relation("DocumentCurrentVersion")
  textIndex  DocumentTextIndex?

  @@unique([documentId, version])
}

enum DocumentTemplateStatus {
  ACTIVE
  ARCHIVED
}

/// Merge template for generated correspondence. Body text lives in
/// immutable versions; generating never modifies the template.
model DocumentTemplate {
  id          String                 @id @default(cuid())
  name        String
  category    DocumentCategory       @default(CORRESPONDENCE)
  status      DocumentTemplateStatus @default(ACTIVE)
  createdById String?
  createdBy   User?                  @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  versions DocumentTemplateVersion[]
}

model DocumentTemplateVersion {
  id          String           @id @default(cuid())
  templateId  String
  template    DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  body        String
  createdById String?
  createdBy   User?            @relation("DocumentTemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  generatedDocuments Document[] @relation("DocumentGeneratedFrom")

  @@unique([templateId, version])
}

enum DocumentIndexStatus {
  PENDING
  INDEXED
  UNSUPPORTED
  FAILED
}

/// Extracted text for one document version, searched only inside the
/// caller's matter scope. UNSUPPORTED (e.g. scanned PDFs, images) is
/// recorded honestly and never matches.
model DocumentTextIndex {
  id                String              @id @default(cuid())
  documentVersionId String              @unique
  documentVersion   DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  status            DocumentIndexStatus @default(PENDING)
  text              String?
  extractor         String?
  extractedAt       DateTime?
}

// F. Notifications ----------------------------------------------------------------

enum NotificationKind {
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  DEADLINE_DUE
  DEADLINE_OVERDUE
  EVENT_REMINDER
  EVENT_CHANGED
  EVENT_CANCELLED
  CHAT_DIRECT_MESSAGE
}

/// Persisted in-app notification. `dedupeKey` makes scheduler retries and
/// concurrent runs idempotent per user. `title` is generated from safe
/// labels — never note, message, or document text. Access to the
/// referenced record is re-checked whenever notifications are listed,
/// counted, or opened.
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  entityType  String
  entityId    String
  matterId    String?
  matter      Matter?          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  dedupeKey   String
  title       String
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  dismissedAt DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, dismissedAt, createdAt])
}

model NotificationPreference {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind
  inApp  Boolean          @default(true)

  @@unique([userId, kind])
}

/// Mutex + last-run record for bounded background jobs (notification
/// scheduler), claimed with an atomic conditional update.
model SchedulerLock {
  id          String    @id @default(cuid())
  name        String    @unique
  lockedUntil DateTime?
  lastRunAt   DateTime?
  lastOutcome String?
}

// G. Calendar occurrence exceptions -------------------------------------------------

enum CalendarExceptionKind {
  CANCELLED
  MODIFIED
}

/// Per-occurrence change to a recurring CalendarEvent, identified by the
/// occurrence's original UTC start (stable identity for future sync).
model CalendarEventException {
  id            String                @id @default(cuid())
  eventId       String
  event         CalendarEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime
  kind          CalendarExceptionKind
  startTime     DateTime?
  endTime       DateTime?
  title         String?
  location      String?
  meetingUrl    String?
  createdById   String?
  createdBy     User?                 @relation("CalendarExceptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@unique([eventId, originalStart])
}

// H. Matter expenses ----------------------------------------------------------------

enum ExpenseCategory {
  FILING_FEE
  EXPERT
  INVESTIGATOR
  TRANSCRIPT
  COPIES
  POSTAGE
  TRAVEL
  SERVICE_OF_PROCESS
  OTHER
}

/// A case cost recorded against a matter — separate from TimeEntry. Money
/// is integer cents; `totalCents` is computed server-side from quantity ×
/// unit cost (half-up). Amounts are visible to ADMIN and the matter's
/// attorneys only. No invoices, payments, trust, or QuickBooks.
model Expense {
  id                String          @id @default(cuid())
  matterId          String
  matter            Matter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  incurredOn        DateTime
  recordedById      String?
  recordedBy        User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  responsibleUserId String?
  responsibleUser   User?           @relation("ExpenseResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  category          ExpenseCategory
  description       String
  quantity          Decimal         @db.Decimal(12, 3)
  unitCostCents     Int
  totalCents        Int
  billable          Boolean         @default(true)
  receiptDocumentId String?
  receiptDocument   Document?       @relation("ExpenseReceipt", fields: [receiptDocumentId], references: [id], onDelete: SetNull)
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([matterId, incurredOn])
}
