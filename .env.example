# Copy this file to .env.local (development) and fill in real values.
# Never commit .env, .env.local, or any file with real secrets.
# See docs/SECURITY.md for handling requirements.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/frye_case_management

# --- Auth (Auth.js / NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Future integrations (placeholders only — do NOT populate until the ---
# --- corresponding integration phase is actually being built, see       ---
# --- docs/ROADMAP.md) ---

# Dropbox (document storage)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Vonage (calls / SMS)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=

# Loop / HighLevel (leads & intake)
HIGHLEVEL_API_KEY=

# QuickBooks Online (billing/accounting)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
