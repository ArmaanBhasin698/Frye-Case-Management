# Copy this file to .env (development) and fill in real values.
# Use .env, not .env.local: the Prisma CLI only auto-loads .env, and
# Next.js reads .env too, so this keeps one file working for both.
# Never commit .env, .env.local, or any file with real secrets.
# See docs/SECURITY.md for handling requirements.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/frye_case_management

# --- Auth (Auth.js / NextAuth) ---
# AUTH_SECRET signs session JWTs — required, and must be a real secret even
# in development (it's what makes a session cookie unforgeable).
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Storage provider for lib/storage/DocumentStore (Discovery files) ---
# "local" (default, or leave unset) writes fictional/test files to
# local-data/discovery-files/ on disk — no credentials needed.
# "dropbox" writes them to a dedicated Dropbox test folder instead — see
# docs/SECURITY.md and docs/ARCHITECTURE.md before using it. Requires the
# three DROPBOX_* variables below; leaving any of them blank while this is
# set to "dropbox" makes the app fail to start with a clear error naming
# which one is missing, rather than silently falling back to local disk.
STORAGE_PROVIDER=local

# Dropbox (document storage) — only needed when STORAGE_PROVIDER=dropbox.
# Create a *scoped app* in the Dropbox App Console
# (https://www.dropbox.com/developers/apps) with access type "App folder"
# (not "Full Dropbox") so it can only ever see its own dedicated folder,
# never the rest of anyone's Dropbox account. Generate a refresh token via
# that app's OAuth2 flow with the files.content.write and
# files.content.read scopes only — nothing broader.
# NEVER commit real values for these three. NEVER paste real values into
# a chat, an issue, a commit message, or a log line.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Every key is written under this root path, on top of whatever the "App
# folder" access type already scopes you to — defense in depth in case
# the connected app ever has "Full Dropbox" access instead. Use a name
# that makes it obvious this is disposable dev/test data, never a real
# firm folder.
DROPBOX_ROOT_PATH=/FryeCaseManagement-DEV

# --- Future integrations (placeholders only — do NOT populate until the ---
# --- corresponding integration phase is actually being built, see       ---
# --- docs/ROADMAP.md) ---

# Vonage (calls / SMS)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=

# Loop / HighLevel (leads & intake)
HIGHLEVEL_API_KEY=

# QuickBooks Online (billing/accounting)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
